COMPOSE_PROJECT_NAME=network-monitor
WEB_BIND=0.0.0.0
WEB_PORT=80
# 默认仅本机。远程使用 SSH 隧道，或改为 0.0.0.0 并限制云安全组来源。
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# 必须替换；也可以由 scripts/init-env.sh 随机生成。
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=4GB
PROMETHEUS_IMAGE=quay.io/prometheus/prometheus:v3.13.4
BLACKBOX_IMAGE=quay.io/prometheus/blackbox-exporter:v0.29.0
GRAFANA_IMAGE=grafana/grafana:13.2.2
PYTHON_IMAGE=python:3.12.15-slim-bookworm
NODE_IMAGE=node:22.23.3-alpine
NGINX_IMAGE=nginx:1.28.3-alpine
# 构建默认使用阿里云 Debian/PyPI 镜像与官方 npm；可以改为自己的可信源。
APT_MIRROR=https://mirrors.aliyun.com/debian
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
NPM_REGISTRY=https://registry.npmjs.org
# 可选 Grafana Web 入口：按 README 配置 GRAFANA_ROOT_URL 与 COMPOSE_FILE。
