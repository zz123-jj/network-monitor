COMPOSE_PROJECT_NAME=network-monitor
WEB_BIND=0.0.0.0
WEB_PORT=80
# 默认仅本机。远程使用 SSH 隧道，或改为 0.0.0.0 并限制云安全组来源。
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# 必须替换；也可以由 scripts/init-env.sh 随机生成。
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=4GB
PROMETHEUS_IMAGE=prom/prometheus:v3.13.4
BLACKBOX_IMAGE=prom/blackbox-exporter:v0.29.0
GRAFANA_IMAGE=grafana/grafana:13.2.3
PYTHON_IMAGE=python:3.12-slim-bookworm
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.28-alpine
# 可选：填写你信任的构建源，留空使用官方。不预设第三方代理。
APT_MIRROR=
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
