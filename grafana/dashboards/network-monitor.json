{
  "uid": "network-monitor",
  "title": "Network Monitor",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "Asia/Shanghai",
  "refresh": "10s",
  "tags": [
    "network",
    "observability"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m"
    ],
    "quick_ranges": [
      {
        "from": "now-5m",
        "to": "now",
        "display": "5m"
      },
      {
        "from": "now-1h",
        "to": "now",
        "display": "1h"
      },
      {
        "from": "now-6h",
        "to": "now",
        "display": "6h"
      },
      {
        "from": "now-24h",
        "to": "now",
        "display": "24h"
      },
      {
        "from": "now-7d",
        "to": "now",
        "display": "7d"
      },
      {
        "from": "now-30d",
        "to": "now",
        "display": "30d"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(network_node_up, region)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(network_node_up{region=~\"$region\"}, node)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Online / Warning nodes",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(network_node_up)",
          "legendFormat": "{{node}} {{port}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1.5,
            "fillOpacity": 0,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Offline nodes",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
